APP_NAME="Stone Crusher ERP"
ENVIRONMENT=development
# The setup script generates a random value in .env. Never reuse this example value.
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

COMPANY_NAME="Your Company Name"
COMPANY_ADDRESS="Your complete business address"
COMPANY_PHONE=""
COMPANY_GSTIN=""
COMPANY_STATE=""
COMPANY_GST_STATE_CODE=""
COMPANY_JURISDICTION=""
COMPANY_BANK_NAME=""
COMPANY_BANK_ACCOUNT=""
COMPANY_BANK_IFSC=""
COMPANY_BANK_BRANCH=""
COMPANY_PAYMENT_TERMS_DAYS=5
COMPANY_LATE_INTEREST_PERCENT=18
COMPANY_LOGO_PATH=""
DOCUMENT_FILE_PREFIX="Invoice"
DOCUMENT_FILENAME_DOUBLE_DOT=true

# MySQL 8.0 or newer is required. SQLite is not supported for an installation.
MYSQL_USER=stone_app
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_DATABASE=stone_creysher
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://stone_app:replace_with_a_url_encoded_password@127.0.0.1:3306/stone_creysher?charset=utf8mb4

# Optional Docker Compose credentials. Replace them before using Docker Compose.
COMPOSE_MYSQL_ROOT_PASSWORD=replace_with_a_root_password
COMPOSE_MYSQL_USER=stone
COMPOSE_MYSQL_PASSWORD=replace_with_a_strong_database_password
COMPOSE_MYSQL_DATABASE=stone_creysher

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=replace_before_first_start
FIRST_ADMIN_FULL_NAME=System Administrator
CHEQUE_COLLECTION_REQUIRES_CLEARANCE=true

VITE_API_BASE_URL=http://localhost:8000
